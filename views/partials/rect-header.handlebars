<div class="rect-header">
  <div class="rect-title">
    <h2>
      {{#if titleLogoId}}
        <img class="rect-title-logo" src="/images/competitions/{{titleLogoId}}.png" alt="{{#if titleLogoAlt}}{{titleLogoAlt}}{{else}}{{title}}{{/if}}" />
      {{/if}}
      {{title}}
    </h2>
  </div>
  <div class="rect-expand">
    {{#if link}}
      <a href="{{link}}" class="more-link more-button">More ►</a>
    {{ else }}
      <div class="more-link more-button">
        <img src="/images/filter-svgrepo-com.svg" alt="Filters" class="filter-icon">
        <span class="toggle-icon">▼</span>
      </div>
    {{/if}}
  </div>
  <div class="rect-league-list" id="league-list-league">
    {{#each leagues}}
    <button type="button" id="img-{{this.id}}" title="{{this.name}}" class="league-option {{../leaguepar}}-league-to-select{{#if (includesID ../selectedLeagues this.id)}} selected-league{{/if}}">
      <img width="30" src="/images/competitions/{{this.id}}.png" alt="{{this.name}}" />
      <span>{{this.name}}</span>
    </button>
    {{/each}}
  </div>
  <div class="rect-expand-league-list"><a href="#" class="more-link more-button">Leagues</a></div>
</div>