<table class="gf-table" id="team-list-table">
  <thead>
    <tr class="main-table-header">
      <th rowspan=2 class="list-header" colspan=2>Teams</th>
      <th rowspan=2 class="form-column list-header" data-stat="form">Form</td>
      <th rowspan=2 title="Played" class="list-header" data-stat="played">P</th>
      <th rowspan=2 title="Club Elo rating from the last 5 seasons" class="list-header{{#if big}} sortable{{/if}}" data-stat="elo">Elo</th>
      <th rowspan=2 title="Average team rating (players with at least 22 minutes)" class="list-header{{#if big}} sortable{{/if}}" data-stat="avgRating">Rtg</th>
      {{#if big}}
      <th rowspan=2 class="list-header" data-stat="winPercentage">Win %</th>
      <th rowspan=2 class="list-header" data-stat="possession"><span class="big-played">Pos %</span></th>
      {{/if}}
      <th colspan=2 title="Goals" class="list-header top-row pair-start" data-paired-filter data-stat="goals">Goals</th>
      <th colspan=2 title="xG" class="list-header top-row pair-start" data-paired-filter data-stat="xG">xG</th>
      <th colspan=2 title="Corners" class="list-header top-row pair-start" data-paired-filter data-stat="corners">Corners</th>
      <th colspan=2 title="Shots" class="list-header top-row pair-start" data-paired-filter data-stat="shotsOnGoal">Shots</th>
      {{#if big}}
      <th colspan=2 title="Fouls" class="list-header top-row pair-start" data-paired-filter data-stat="fouls">Fouls</th>
      <th colspan=2 title="Yellow Cards" class="list-header top-row pair-start" data-paired-filter data-stat="yellowCards"><span
          class="big-played">Yellow Cards</span><span class="small=played">Yell</span></th>
      <th colspan=2 title="Red Cards" class="list-header top-row pair-start" data-paired-filter data-stat="redCards"><span class="big-played">Red
          Cards</span><span class="small=played">Reds</span></th>
      <th colspan=2 title="Offsides" class="list-header top-row pair-start" data-paired-filter data-stat="offsides">Offsides</th>
      {{/if}}

    </tr>
    <tr class="main-table-header" style="border-top:0">
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-start pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="goals">For</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="goals">Ag</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-start pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="xG">For</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="xG">Ag</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-start pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="corners">For</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="corners">Ag</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-start pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="shotsOnGoal">For</th>
      <th{{#if big}} title="Click to sort"{{/if}} class="list-header pair-col sub-header{{#if big}} sortable{{/if}}" data-stat="shotsOnGoal">Ag</th>
      {{#if big}}
      <th title="Click to sort" class="list-header pair-start pair-col sortable sub-header" data-stat="fouls">For</th>
      <th title="Click to sort" class="list-header pair-col sortable sub-header" data-stat="fouls">Ag</th>
      <th title="Click to sort" class="list-header pair-start pair-col sortable sub-header" data-stat="yellowCards">For</th>
      <th title="Click to sort" class="list-header pair-col sortable sub-header" data-stat="yellowCards">Ag</th>
      <th title="Click to sort" class="list-header pair-start pair-col sortable sub-header" data-stat="redCards">For</th>
      <th title="Click to sort" class="list-header pair-col sortable sub-header" data-stat="redCards">Ag</th>
      <th title="Click to sort" class="list-header pair-start pair-col sortable sub-header" data-stat="offsides">For</th>
      <th title="Click to sort" class="list-header pair-col sortable sub-header" data-stat="offsides">Ag</th>
      {{/if}}

    </tr>
  </thead>
  <tbody>

    {{#each teams as |thisTeam|}}
    <tr>
      <td style="padding:4px; border-right:none; cursor:pointer"
        onclick="window.location.href='/team?ID={{thisTeam.id}}'">
        <img src="images/logos/{{thisTeam.id}}.png" class="logo-picture" alt="{{thisTeam.name}}" title="{{thisTeam.name}}" />
      </td>
      <td class="team-name" style="cursor:pointer" onclick="window.location.href='/team?ID={{thisTeam.id}}'">
        {{thisTeam.name}}</td>
      <td style="padding: 0px;" data-stat="form">
        <div style="display: flex; align-items: center; height: 100%;">
            {{#each thisTeam.formArray as |form|}}
            <span class="form-indicator {{form}}"></span>
            {{/each}}
        </div>
      </td>
      
      <td style="text-align: center;" data-stat="played">{{thisTeam.played}}</td>
      <td style="text-align: center;" data-stat="elo">{{#if thisTeam.elo}}{{thisTeam.elo}}{{else}}—{{/if}}</td>
      <td style="text-align: center;" data-stat="avgRating" class="{{ratingClass thisTeam.total.avgRating}}">{{#if thisTeam.total.avgRating}}{{thisTeam.total.avgRating}}{{else}}—{{/if}}</td>

      {{#if ../big}}
      <td style="text-align: center;" data-stat="winPercentage">{{ thisTeam.total.winPercentage }}</td>
      <td style="text-align: center;" data-stat="possession">{{ thisTeam.perGame.possession}}</td>
      {{/if}}

      <td class="pair-start pair-col" style="text-align: center;" data-stat="goals">{{thisTeam.total.goals}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="goals">{{thisTeam.total.goalsAgainst}}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="xG">{{ thisTeam.total.xG }}</td>
      <td class="pair-col" style="text-align: center;" data-stat="xG">{{ thisTeam.total.xGA }}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="corners">{{thisTeam.total.corners}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="corners">{{thisTeam.total.cornersAgainst}}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="shotsOnGoal">{{thisTeam.total.shotsOnGoal}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="shotsOnGoal">{{thisTeam.total.shotsOnGoalAgainst}}</td>

      {{#if ../big}}
      <td class="pair-start pair-col" style="text-align: center;" data-stat="fouls">{{thisTeam.total.fouls}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="fouls">{{thisTeam.total.foulsAgainst}}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="yellowCards">{{thisTeam.total.yellowCards}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="yellowCards">{{thisTeam.total.yellowCardsAgainst}}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="redCards">{{thisTeam.total.redCards}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="redCards">{{thisTeam.total.redCardsAgainst}}</td>
      <td class="pair-start pair-col" style="text-align: center;" data-stat="offsides">{{thisTeam.total.offsides}}</td>
      <td class="pair-col" style="text-align: center;" data-stat="offsides">{{thisTeam.total.offsidesAgainst}}</td>
      {{/if}}
    </tr>
    {{/each}}
  </tbody>
</table>