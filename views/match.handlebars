<script src="./../controllers/refetch-ui.js"></script>
<script type="module" src="./../controllers/match.js"></script>
<div class="container match-page">
  {{#if matchInfo}}
  <div class="match-header">
    <div class="team">
      <img class="cursor-pointer" src="images/logos/{{matchInfo.teams.home.id}}.png" alt="{{matchInfo.teams.home.name}}"
        title="{{matchInfo.teams.home.name}}" onclick="window.location.href='team?ID={{matchInfo.teams.home.id}}'" />
      <div class="cursor-pointer" onclick="window.location.href='team?ID={{matchInfo.teams.home.id}}'">
        {{matchInfo.teams.home.name}}</div>
      <div class="elo-change-line" title="Current Elo">
        Elo {{#if matchElo.home}}{{matchElo.home}}{{else}}—{{/if}}
      </div>
    </div>

    <div class="score-section">
      <div class="score">{{matchInfo.goals.home}} - {{matchInfo.goals.away}}</div>
      <div><a class="cursor-pointer" style="color: white;"
          href="/league?id={{matchInfo.league.id}}">{{headerLeagueName}}</a> - {{matchInfo.league.round}} -
        {{formatDate matchInfo.fixture.date}}</div>
      <span class="status">{{matchInfo.fixture.status.short}}</span>
      {{#if matchElo.change}}
      <span class="match-elo-delta" title="Elo change for this match">
        {{#if matchElo.change.home}}<span class="elo-change {{matchElo.change.home.direction}}">{{matchElo.change.home.display}}</span>{{/if}}
        {{#if matchElo.change.away}}<span class="elo-change {{matchElo.change.away.direction}}">{{matchElo.change.away.display}}</span>{{/if}}
      </span>
      {{/if}}
      {{#if isLocal}}
      <button type="button" id="refetch-match-btn" class="match-refetch-btn" data-match-id="{{matchID}}">
        Refetch
      </button>
      {{/if}}
    </div>

    <div class="team">
      <img class="cursor-pointer" src="images/logos/{{matchInfo.teams.away.id}}.png" alt="{{matchInfo.teams.away.name}}"
        title="{{matchInfo.teams.away.name}}" onclick="window.location.href='team?ID={{matchInfo.teams.away.id}}'" />
      <div class="cursor-pointer" onclick="window.location.href='team?ID={{matchInfo.teams.away.id}}'">
        {{matchInfo.teams.away.name}}</div>
      <div class="elo-change-line" title="Current Elo">
        Elo {{#if matchElo.away}}{{matchElo.away}}{{else}}—{{/if}}
      </div>
    </div>
  </div>
  {{/if}}

  {{#if (isFinishedStatus matchInfo.fixture.status.short)}}
  {{#if teamList.length}}
  <div class="match-tabs" role="tablist" aria-label="Match view tabs">
    <button id="match-summary-tab" class="match-tab-btn is-active" type="button" role="tab" aria-selected="true"
      aria-controls="match-summary-panel">Match Summary</button>
    <button id="match-preview-tab" class="match-tab-btn" type="button" role="tab" aria-selected="false"
      aria-controls="match-preview-panel">Match Preview</button>
  </div>
  {{/if}}
  {{/if}}

  {{#if (eq matchInfo.fixture.status.short "NS")}}
  {{else}}
  <div id="match-summary-panel" class="match-content-panel is-active">
    <div class="match-center-layout">
      <div class="lineup-panel lineup-home">
        {{#if matchInfo.lineups}}
        {{#each matchInfo.lineups}}
        {{#if (eq this.team.id ../matchInfo.teams.home.id)}}
        <table class="gf-table lineup-table">
          <thead>
            <tr class="lineup-title-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Home Lineup</th>
            </tr>
            <tr class="lineup-stat-header-row">
              <th colspan="2"></th>
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xg")}}<th>xG</th>{{/if}}
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xgot")}}<th>xGOT</th>{{/if}}
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xa")}}<th>xA</th>{{/if}}
              <th>Rtg</th>
            </tr>
            <tr class="lineup-section-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Starting 11</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.startXI}}
            <tr class="lineup-player-row">
              <td class="lineup-number-td">{{this.player.number}}</td>
              <td><a class="lineup-player-name cursor-pointer"
                  href="/player?id={{this.player.id}}">{{this.player.name}}</a></td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="xG">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xg") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="xGOT">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="xA">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td
                class="lineup-rating-td {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}{{ratingClass rating}}{{/with}}">
                {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}<span
                  class="lineup-rating">{{#if rating}}{{rating}}{{else}}-{{/if}}</span>{{/with}}</td>
            </tr>
            {{/each}}
            {{#if this.substitutes.length}}
            <tr class="lineup-section-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Substitutes</th>
            </tr>
            {{#each this.substitutes}}
            <tr class="lineup-player-row lineup-sub-row">
              <td class="lineup-number-td">{{this.player.number}}</td>
              <td><a class="lineup-player-name cursor-pointer"
                  href="/player?id={{this.player.id}}">{{this.player.name}}</a></td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="xG">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xg") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="xGOT">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="xA">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td
                class="lineup-rating-td {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}{{ratingClass rating}}{{/with}}">
                {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}<span
                  class="lineup-rating">{{#if rating}}{{rating}}{{else}}-{{/if}}</span>{{/with}}</td>
            </tr>
            {{/each}}
            {{/if}}
            {{#with (matchTeamAverageRating this ../matchInfo.players ../matchInfo.fotmob ../matchInfo.teams.home.id) as |avgRating|}}
            <tr class="lineup-footer-row lineup-avg-row">
              <td colspan="2">Team Avg Rating</td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="Team xG">{{#with (fotmobTeamXgFor ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id) as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="Team xGOT">{{#with (fotmobTeamStatSum ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="Team xA">{{#with (fotmobTeamStatSum ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td class="lineup-rating-td {{ratingClass avgRating}}"><span class="lineup-rating">{{#if
                  avgRating}}{{avgRating}}{{else}}-{{/if}}</span></td>
            </tr>
            {{/with}}
            {{#if this.formation}}
            <tr class="lineup-footer-row lineup-meta-row">
              <td colspan="{{lineupColspan ../matchInfo.fotmob}}">Formation: {{this.formation}}</td>
            </tr>
            {{/if}}
            {{#if this.coach.name}}
            <tr class="lineup-footer-row lineup-meta-row">
              <td colspan="{{lineupColspan ../matchInfo.fotmob}}">Manager: {{this.coach.name}}</td>
            </tr>
            {{/if}}
          </tbody>
        </table>
        {{/if}}
        {{/each}}
        {{else}}
        <div class="lineup-empty">No lineup data available.</div>
        {{/if}}
      </div>

      <div class="match-center-column">
        <div class="match-events-panel goals-only">
          <div class="match-events-header">
            <h3>Match Events</h3>
            {{#if matchInfo.events}}
            <button type="button" id="events-toggle-btn" class="more-button match-events-toggle"
              aria-pressed="false">Show All Events</button>
            {{/if}}
          </div>
          {{#if matchInfo.events}}
          <div class="match-events-grid">
            {{#each matchInfo.events}}
            <div class="event-row {{#if (isGoalEvent this.type this.detail)}}event-goal{{else}}event-other{{/if}}">
              <div class="event-side event-side-home">
                {{#if (eq this.team.id ../matchInfo.teams.home.id)}}
                <span class="event-text"><a class="event-player-link cursor-pointer"
                    href="/player?id={{this.player.id}}">{{this.player.name}}</a> - {{this.type}}{{#if this.detail}}
                  ({{this.detail}}){{/if}}</span>
                {{/if}}
              </div>

              <span class="event-minute">{{this.time.elapsed}}'</span>

              <div class="event-side event-side-away">
                {{#if (eq this.team.id ../matchInfo.teams.away.id)}}
                <span class="event-text"><a class="event-player-link cursor-pointer"
                    href="/player?id={{this.player.id}}">{{this.player.name}}</a> - {{this.type}}{{#if this.detail}}
                  ({{this.detail}}){{/if}}</span>
                {{/if}}
              </div>
            </div>
            {{/each}}
          </div>
          {{else}}
          <div class="lineup-empty">No events available.</div>
          {{/if}}
        </div>

        <div class="match-stats-panel">
          {{#if matchStatistics.length}}
          <table class="gf-table match-stats-table">
            <thead>
              <tr>
                <th colspan="3">
                  Match Statistics
                </th>
              </tr>
            </thead>
            <tbody>
              {{#each matchStatistics}}
              <tr>
                <td class="match-stats-home">{{this.homeValue}}</td>
                <td class="match-stats-type">{{this.type}}</td>
                <td class="match-stats-away">{{this.awayValue}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
          {{else}}
          <div class="lineup-empty">No statistics available.</div>
          {{/if}}
        </div>
      </div>

      <div class="lineup-panel lineup-away">
        {{#if matchInfo.lineups}}
        {{#each matchInfo.lineups}}
        {{#if (eq this.team.id ../matchInfo.teams.away.id)}}
        <table class="gf-table lineup-table">
          <thead>
            <tr class="lineup-title-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Away Lineup</th>
            </tr>
            <tr class="lineup-stat-header-row">
              <th colspan="2"></th>
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xg")}}<th>xG</th>{{/if}}
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xgot")}}<th>xGOT</th>{{/if}}
              {{#if (fotmobHasLineupStat ../matchInfo.fotmob "xa")}}<th>xA</th>{{/if}}
              <th>Rtg</th>
            </tr>
            <tr class="lineup-section-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Starting 11</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.startXI}}
            <tr class="lineup-player-row">
              <td class="lineup-number-td">{{this.player.number}}</td>
              <td><a class="lineup-player-name cursor-pointer"
                  href="/player?id={{this.player.id}}">{{this.player.name}}</a></td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="xG">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xg") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="xGOT">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="xA">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td
                class="lineup-rating-td {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}{{ratingClass rating}}{{/with}}">
                {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}<span
                  class="lineup-rating">{{#if rating}}{{rating}}{{else}}-{{/if}}</span>{{/with}}</td>
            </tr>
            {{/each}}
            {{#if this.substitutes.length}}
            <tr class="lineup-section-row">
              <th colspan="{{lineupColspan ../matchInfo.fotmob}}">Substitutes</th>
            </tr>
            {{#each this.substitutes}}
            <tr class="lineup-player-row lineup-sub-row">
              <td class="lineup-number-td">{{this.player.number}}</td>
              <td><a class="lineup-player-name cursor-pointer"
                  href="/player?id={{this.player.id}}">{{this.player.name}}</a></td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="xG">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xg") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="xGOT">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="xA">{{#with (matchLineupStat ../../matchInfo.fotmob ../../matchInfo.teams.home.id ../team.id this.player.name this.player.number "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td
                class="lineup-rating-td {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}{{ratingClass rating}}{{/with}}">
                {{#with (matchLineupRating ../../matchInfo.players ../team.id this.player.id this.player.name this.player.number ../../matchInfo.fotmob ../../matchInfo.teams.home.id) as |rating|}}<span
                  class="lineup-rating">{{#if rating}}{{rating}}{{else}}-{{/if}}</span>{{/with}}</td>
            </tr>
            {{/each}}
            {{/if}}
            {{#with (matchTeamAverageRating this ../matchInfo.players ../matchInfo.fotmob ../matchInfo.teams.home.id) as |avgRating|}}
            <tr class="lineup-footer-row lineup-avg-row">
              <td colspan="2">Team Avg Rating</td>
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xg")}}<td class="lineup-xg-td" title="Team xG">{{#with (fotmobTeamXgFor ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id) as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xgot")}}<td class="lineup-xg-td" title="Team xGOT">{{#with (fotmobTeamStatSum ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id "xgot") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              {{#if (fotmobHasLineupStat ../../matchInfo.fotmob "xa")}}<td class="lineup-xg-td" title="Team xA">{{#with (fotmobTeamStatSum ../../matchInfo.fotmob ../team.id ../../matchInfo.teams.home.id "xa") as |xg|}}{{#if xg}}{{xg}}{{else}}-{{/if}}{{/with}}</td>{{/if}}
              <td class="lineup-rating-td {{ratingClass avgRating}}"><span class="lineup-rating">{{#if
                  avgRating}}{{avgRating}}{{else}}-{{/if}}</span></td>
            </tr>
            {{/with}}
            {{#if this.formation}}
            <tr class="lineup-footer-row lineup-meta-row">
              <td colspan="{{lineupColspan ../matchInfo.fotmob}}">Formation: {{this.formation}}</td>
            </tr>
            {{/if}}
            {{#if this.coach.name}}
            <tr class="lineup-footer-row lineup-meta-row">
              <td colspan="{{lineupColspan ../matchInfo.fotmob}}">Manager: {{this.coach.name}}</td>
            </tr>
            {{/if}}
          </tbody>
        </table>
        {{/if}}
        {{/each}}
        {{else}}
        <div class="lineup-empty">No lineup data available.</div>
        {{/if}}
      </div>
    </div>
  </div>

  {{/if}}

  {{#if teamList.length}}
  <div id="match-preview-panel"
    class="match-content-panel {{#if (isFinishedStatus matchInfo.fixture.status.short)}}{{else}}is-active{{/if}}">
    {{#each teamList}}
    <div class="team-card gf-table {{#if (eq this.id ../matchInfo.teams.away.id)}}team-card-away{{/if}}">
      <div class="team-header">
        <img class="cursor-pointer" src="images/logos/{{this.id}}.png" alt="{{this.name}}" title="{{this.name}}"
          onclick="window.location.href='team?ID={{this.id}}'" />
        <div style="width: 92%;">
          <h3 class="cursor-pointer" onclick="window.location.href='team?ID={{this.id}}'">{{this.name}}</h3>
          <div class="record preview-record">
            <table>
              <tr>
                <td>{{this.played}} played</td>
                <td>{{percentage this.wins this.played}}% win</td>
                <td>{{this.wins}}W {{this.draws}}D {{this.losses}}L</td>
                <td class="preview-last-cell">
                  {{#if this.matches.[0]}}
                  <span class="preview-last-label">Last played</span>
                  <span class="preview-last-when">{{daysAgo this.matches.[0].date}}</span>
                  {{/if}}
                </td>
                <td class="preview-form-cell">
                  <div class="preview-form" title="Last 5 matches">
                    {{#each this.formArray as |form|}}
                    <span class="form-indicator {{form}}"></span>
                    {{/each}}
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </div>
      </div>

      <table class="gf-table player-stats-table preview-stats-table">
        <thead>
          <tr class="main-table-header">
            <th>Stat</th>
            <th class="center-td">Total</th>
            <th class="center-td">Per game</th>
            <th class="center-td" title="Last 5 games">Last 5</th>
            <th class="center-td" title="Last 5 games, per game">Last 5 / game</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="player-stat-name">Points</td>
            <td class="center-td">{{this.total.points}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.points}}</td>
            <td class="center-td">{{this.last5.points}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.points this.perGame.points}}">{{this.last5PerGame.points}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">xPoints</td>
            <td class="center-td">{{this.total.xPoints}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.xPoints}}</td>
            <td class="center-td">{{this.last5.xPoints}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.xPoints this.perGame.xPoints}}">{{this.last5PerGame.xPoints}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">Goals</td>
            <td class="center-td">{{this.total.goals}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.goals}}</td>
            <td class="center-td">{{this.last5.goals}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.goals this.perGame.goals}}">{{this.last5PerGame.goals}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">Goals Against</td>
            <td class="center-td">{{this.total.goalsAgainst}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.goalsAgainst}}</td>
            <td class="center-td">{{this.last5.goalsAgainst}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.goalsAgainst this.perGame.goalsAgainst "lower"}}">{{this.last5PerGame.goalsAgainst}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">xG</td>
            <td class="center-td">{{this.total.xG}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.xG}}</td>
            <td class="center-td">{{this.last5.xG}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.xG this.perGame.xG}}">{{this.last5PerGame.xG}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">xGA</td>
            <td class="center-td">{{this.total.xGA}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.xGA}}</td>
            <td class="center-td">{{this.last5.xGA}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.xGA this.perGame.xGA "lower"}}">{{this.last5PerGame.xGA}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">Corners</td>
            <td class="center-td">{{this.total.corners}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.corners}}</td>
            <td class="center-td">{{this.last5.corners}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.corners this.perGame.corners}}">{{this.last5PerGame.corners}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">Shots on Goal</td>
            <td class="center-td">{{this.total.shotsOnGoal}}</td>
            <td class="center-td player-stat-rate">{{this.perGame.shotsOnGoal}}</td>
            <td class="center-td">{{this.last5.shotsOnGoal}}</td>
            <td class="center-td"><span class="player-stat-trend {{rateTrend this.last5PerGame.shotsOnGoal this.perGame.shotsOnGoal}}">{{this.last5PerGame.shotsOnGoal}}</span></td>
          </tr>
          <tr>
            <td class="player-stat-name">Elo</td>
            <td class="center-td">{{#if this.eloChange.total}}<span class="elo-change {{this.eloChange.total.direction}}">{{this.eloChange.total.display}}</span>{{else}}—{{/if}}</td>
            <td class="center-td">{{#if this.eloChange.perGame}}<span class="elo-change {{this.eloChange.perGame.direction}}">{{this.eloChange.perGame.display}}</span>{{else}}—{{/if}}</td>
            <td class="center-td">{{#if this.eloChange.last5}}<span class="elo-change {{this.eloChange.last5.direction}}">{{this.eloChange.last5.display}}</span>{{else}}—{{/if}}</td>
            <td class="center-td">{{#if this.eloChange.last5PerGame}}<span class="elo-change {{this.eloChange.last5PerGame.direction}}">{{this.eloChange.last5PerGame.display}}</span>{{else}}—{{/if}}</td>
          </tr>
          <tr>
            <td class="player-stat-name">Elo of teams played</td>
            <td class="center-td">{{#if this.opponentElo.total}}{{this.opponentElo.total}}{{else}}—{{/if}}</td>
            <td class="center-td player-stat-rate">{{#if this.opponentElo.perGame}}{{this.opponentElo.perGame}}{{else}}—{{/if}}</td>
            <td class="center-td">{{#if this.opponentElo.last5}}{{this.opponentElo.last5}}{{else}}—{{/if}}</td>
            <td class="center-td">{{#if this.opponentElo.last5PerGame}}<span class="player-stat-trend {{rateTrend this.opponentElo.last5PerGame this.opponentElo.perGame}}">{{this.opponentElo.last5PerGame}}</span>{{else}}—{{/if}}</td>
          </tr>
        </tbody>
      </table>
      <div class="match-detail-list">
        {{#each this.matches}}
        <div class="match-detail cursor-pointer" data-match-id="{{this.id}}" role="link" tabindex="0"
          aria-label="Open match {{this.homeTeam.name}} vs {{this.awayTeam.name}}">
          <div class="match-opponent">
            <div class="home-side">
              <a href="/team?ID={{this.homeTeam.id}}" aria-label="{{this.homeTeam.name}} team page">
                <img width="40px" src="images/logos/{{this.homeTeam.id}}.png" alt="{{this.homeTeam.name}}">
              </a>
              <a class="team-name" href="/team?ID={{this.homeTeam.id}}">{{this.homeTeam.name}}</a>
            </div>
            <div class="center-info">
              <span class="match-score">{{this.homeScore}} - {{this.awayScore}}</span>
              <span class="match-date"><a class="match-competition-link"
                  href="/league?id={{this.leagueId}}">{{this.league}}</a> - {{formatDate this.date}}</span>
            </div>
            <div class="away-side">
              <a class="team-name" href="/team?ID={{this.awayTeam.id}}">{{this.awayTeam.name}}</a>
              <a href="/team?ID={{this.awayTeam.id}}" aria-label="{{this.awayTeam.name}} team page">
                <img width="40px" src="images/logos/{{this.awayTeam.id}}.png" alt="{{this.awayTeam.name}}">
              </a>
            </div>
          </div>
          <div class="match-stats-detail">
            <span>Corners: {{this.stats.cornersHome}} - {{this.stats.cornersAway}}</span>
            <span>Shots: {{this.stats.shotsOnGoalHome}} - {{this.stats.shotsOnGoalAway}}</span>
            {{#if this.eloChange}}
            <span>Elo change: <span class="elo-change {{this.eloChange.direction}}">{{this.eloChange.display}}</span></span>
            {{/if}}
            {{#if this.xG}}
            <span>xG: {{this.stats.xGHome}} - {{this.stats.xGAway}}</span>
            {{/if}}
          </div>
        </div>
        {{/each}}
      </div>

    </div>
    {{/each}}

    <div class="ai-predict-rect">
      <button type="button" id="ai-predict-btn" class="ai-predict-btn">
        ✨ Predict Match &mdash; AI Powered
      </button>
      <div id="ai-predict-result" class="ai-predict-result" style="display:none;">
        <div class="ai-predict-score-row">
          <span class="ai-predict-team">{{matchInfo.teams.home.name}}</span>
          <span class="ai-predict-score" id="ai-score-home">-</span>
          <span class="ai-predict-separator">:</span>
          <span class="ai-predict-score" id="ai-score-away">-</span>
          <span class="ai-predict-team">{{matchInfo.teams.away.name}}</span>
        </div>
        <div class="ai-predict-stats">
          <div class="ai-predict-stat">
            <span class="ai-predict-stat-label">Corners</span>
            <span class="ai-predict-stat-values"><span id="ai-corners-home">-</span> &ndash; <span
                id="ai-corners-away">-</span></span>
          </div>
          <div class="ai-predict-stat">
            <span class="ai-predict-stat-label">Shots on Goal</span>
            <span class="ai-predict-stat-values"><span id="ai-shots-home">-</span> &ndash; <span
                id="ai-shots-away">-</span></span>
          </div>
          <div class="ai-predict-stat">
            <span class="ai-predict-stat-label">Possession</span>
            <span class="ai-predict-stat-values"><span id="ai-poss-home">-</span>% &ndash; <span
                id="ai-poss-away">-</span>%</span>
          </div>
        </div>
        <div id="ai-predict-outcome" class="ai-predict-outcome"></div>
        <div id="ai-predict-reasoning" class="ai-predict-reasoning">

        </div>
        <div class="ai-predict-logo">
          <img src="/images/logo.png" alt="AI" style="width:32px; vertical-align:middle;" />
        </div>
      </div>
    </div>

  </div>
  {{/if}}

</div>

<style>
  .ai-predict-logo {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }

  .ai-predict-rect {
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    border: 1px solid #e94560;
    border-radius: 10px;
    padding: 24px 28px;
    margin: 24px auto;
    max-width: 700px;
    text-align: center;
    grid-column: 1 / -1;
  }

  .ai-predict-btn {
    background: linear-gradient(90deg, #e94560, #c0392b);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 12px 32px;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .ai-predict-btn:hover {
    opacity: 0.85;
  }

  .ai-predict-result {
    margin-top: 22px;
  }

  .ai-predict-score-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 18px;
  }

  .ai-predict-team {
    color: #e0e0e0;
    font-size: 20px;
    font-weight: 600;
    width: 30%;
  }

  .ai-predict-score {
    color: #e94560;
    font-size: 2rem;
    font-weight: 800;
    min-width: 40px;
    display: inline-block;
  }

  .ai-predict-separator {
    color: #e0e0e0;
    font-size: 2rem;
    font-weight: 300;
  }

  .ai-predict-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-bottom: 14px;
  }

  .ai-predict-stat {
    background: rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    padding: 8px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 110px;
  }

  .ai-predict-stat-label {
    color: #aaa;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .ai-predict-stat-values {
    color: #fff;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .ai-predict-outcome {
    color: #c8d6e5;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-predict-reasoning {
    color: #aab4be;
    font-size: 0.85rem;
    line-height: 1.55;
    max-width: 560px;
    margin: 0 auto 10px;
  }

  .ai-predict-note {
    color: #777;
    font-size: 0.75rem;
    font-style: italic;
    margin-top: 6px;
  }
</style>

<script>
  const predictBtn = document.getElementById('ai-predict-btn');
  const resultDiv = document.getElementById('ai-predict-result');

  const setPredictionValue = (elementId, value, suffix = '') => {
    const element = document.getElementById(elementId);
    if (!element) {
      return;
    }

    if (value === null || value === undefined || value === '') {
      element.textContent = '-';
      return;
    }

    element.textContent = `${value}${suffix}`;
  };

  const renderPrediction = (prediction) => {
    setPredictionValue('ai-score-home', prediction?.score?.home);
    setPredictionValue('ai-score-away', prediction?.score?.away);
    setPredictionValue('ai-corners-home', prediction?.stats?.corners?.home);
    setPredictionValue('ai-corners-away', prediction?.stats?.corners?.away);
    setPredictionValue('ai-shots-home', prediction?.stats?.shotsOnGoal?.home);
    setPredictionValue('ai-shots-away', prediction?.stats?.shotsOnGoal?.away);
    setPredictionValue('ai-xg-home', prediction?.stats?.xG?.home);
    setPredictionValue('ai-xg-away', prediction?.stats?.xG?.away);
    setPredictionValue('ai-poss-home', prediction?.stats?.possession?.home);
    setPredictionValue('ai-poss-away', prediction?.stats?.possession?.away);

    const outcomeEl = document.getElementById('ai-predict-outcome');
    if (outcomeEl) {
      const h = prediction?.score?.home;
      const a = prediction?.score?.away;
      if (h != null && a != null) {
        if (h > a) outcomeEl.textContent = `Predicted result: {{matchInfo.teams.home.name}} win`;
        else if (a > h) outcomeEl.textContent = `Predicted result: {{matchInfo.teams.away.name}} win`;
        else outcomeEl.textContent = 'Predicted result: Draw';
      } else {
        outcomeEl.textContent = '';
      }
    }

    const reasoningEl = document.getElementById('ai-predict-reasoning');
    if (reasoningEl) {
      reasoningEl.textContent = prediction?.reasoning ?? '';
    }
  };

  if (predictBtn && resultDiv) {
    predictBtn.addEventListener('click', async function () {
      if (resultDiv.style.display !== 'none') {
        resultDiv.style.display = 'none';
        this.innerHTML = '✨ Predict Match &mdash; AI Powered';
        return;
      }

      this.textContent = 'Loading prediction...';
      this.disabled = true;

      try {
        const response = await fetch(`/predict-match?matchID={{matchID}}`);
        if (!response.ok) {
          throw new Error('Prediction request failed');
        }

        const data = await response.json();
        renderPrediction(data.prediction || {});

        resultDiv.style.display = 'block';
        this.textContent = '✨ Hide Prediction';
      } catch (error) {
        console.error('Prediction call failed:', error);
        resultDiv.style.display = 'none';
        this.textContent = 'Prediction failed, try again';
      } finally {
        this.disabled = false;
      }
    });
  }
</script>