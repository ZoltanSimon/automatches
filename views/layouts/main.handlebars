<!DOCTYPE html>
<html lang="en">

<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-CJMS2M65FH"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-CJMS2M65FH');
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
    rel="stylesheet"
  >

  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{{title}}</title>
  <meta name="description" content="{{description}}">
  <meta name="robots" content="{{#if robots}}{{robots}}{{else}}index, follow, max-image-preview:large{{/if}}">
  {{#unless robots}}
  <link rel="canonical" href="{{#if canonicalPath}}{{absUrl canonicalPath}}{{else}}{{canonicalUrl}}{{/if}}">
  {{/unless}}

  <meta property="og:site_name" content="{{siteName}}">
  <meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}">
  <meta property="og:title" content="{{title}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:url" content="{{#if canonicalPath}}{{absUrl canonicalPath}}{{else}}{{canonicalUrl}}{{/if}}">
  <meta property="og:image" content="{{#if ogImage}}{{absUrl ogImage}}{{else}}{{ogImageUrl}}{{/if}}">
  <meta property="og:locale" content="en_GB">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{title}}">
  <meta name="twitter:description" content="{{description}}">
  <meta name="twitter:image" content="{{#if ogImage}}{{absUrl ogImage}}{{else}}{{ogImageUrl}}{{/if}}">
  {{#if jsonLd}}
  <script type="application/ld+json">{{{jsonLd}}}</script>
  {{/if}}

  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="stylesheet" href="{{{asset "/css/header.css"}}}" />
  <link rel="stylesheet" href="{{{asset "/css/style.css"}}}" />

  <script async
    src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5722075030849203"
    crossorigin="anonymous">
  </script>
</head>

<body>
  <header class="site-header">
    <div class="logo-title">
      <div class="logo-brand">
        <a href="/"><img src="/images/logo.png" alt="Generation Football logo" /></a>
        <a href="/" aria-label="Generation Football home"><span class="site-title">generationFOOTBALL</span></a>
      </div>
      <div class="header-actions">
        <a href="/starting-11" class="header-link" title="Starting 11 Builder" {{#if (eq currentPath "/starting-11")}}aria-current="page"{{/if}}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
          <span class="header-link-text">Starting 11</span>
        </a>
        <a href="/wiki" class="header-link" title="GF Wiki" {{#if (startsWith currentPath "/wiki")}}aria-current="page"{{/if}}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 4h6a4 4 0 0 1 4 4v13a3 3 0 0 0-3-3H2z"/><path d="M22 4h-6a4 4 0 0 0-4 4v13a3 3 0 0 1 3-3h7z"/></svg>
          <span class="header-link-text">GF Wiki</span>
        </a>
        <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">&#9776;</button>
      </div>
    </div>
    <div class="header-league-search-wrapper">
      {{> league-search leagues=headerLeagues}}
    </div>
    <nav id="mainNav">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/top-players">Players</a></li>
        <li><a href="/top-teams">Teams</a></li>
        <li><a href="/transfers">Transfers</a></li>
        <li><a href="/about">About</a></li>
      </ul>
    </nav>
  </header>
  <script>
    (function () {
      var btn = document.getElementById('navToggle');
      var nav = document.getElementById('mainNav');
      if (btn && nav) {
        btn.addEventListener('click', function () {
          var open = nav.classList.toggle('nav-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
          btn.classList.toggle('nav-toggle--open', open);
        });
      }

      var searchBlocks = document.querySelectorAll('.js-league-search');
      if (searchBlocks.length === 0) {
        return;
      }

      var closeAllSearches = function () {
        searchBlocks.forEach(function (search) {
          var trigger = search.querySelector('.league-search-trigger');
          var dropdown = search.querySelector('.league-search-dropdown');
          if (!trigger || !dropdown) return;
          dropdown.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          search.classList.remove('open');
        });
      };

      searchBlocks.forEach(function (search) {
        var trigger = search.querySelector('.league-search-trigger');
        var dropdown = search.querySelector('.league-search-dropdown');
        var input = search.querySelector('.league-search-input');
        var items = Array.prototype.slice.call(search.querySelectorAll('.league-search-item'));
        var emptyState = search.querySelector('.league-search-empty');

        if (!trigger || !dropdown || !input) {
          return;
        }

        trigger.addEventListener('click', function () {
          var isOpen = !dropdown.hidden;
          closeAllSearches();

          if (!isOpen) {
            dropdown.hidden = false;
            search.classList.add('open');
            trigger.setAttribute('aria-expanded', 'true');
            input.focus();
          }
        });

        input.addEventListener('input', function () {
          var query = input.value.trim().toLowerCase();
          var visibleCount = 0;

          items.forEach(function (item) {
            var nameElement = item.querySelector('.league-search-name');
            var leagueName = (nameElement ? nameElement.textContent : '').toLowerCase();
            var show = leagueName.indexOf(query) !== -1;
            item.hidden = !show;
            if (show) visibleCount += 1;
          });

          if (emptyState) {
            emptyState.hidden = visibleCount !== 0;
          }
        });

        search.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') {
            closeAllSearches();
            trigger.focus();
          }
        });

        dropdown.addEventListener('click', function (event) {
          if (event.target.closest('.league-search-link')) {
            closeAllSearches();
          }
        });
      });

      document.addEventListener('click', function (event) {
        var clickedInsideAnySearch = Array.prototype.some.call(searchBlocks, function (search) {
          return search.contains(event.target);
        });

        if (!clickedInsideAnySearch) {
          closeAllSearches();
        }
      });
    })();
  </script>
  <main>
    {{{body}}}
  </main>
  <footer>
    <p>&copy; 2026 generationFOOTBALL - <a style="color: white" href="/privacy-policy">Privacy Policy</a> {{> donate-button compact=true}}</p>
  </footer>
</body>

</html>