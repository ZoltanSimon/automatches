<script src="./../controllers/refetch-ui.js"></script>
<script type="module" src="./../controllers/player.js"></script>
<link rel="stylesheet" href="css/league.css" />

<div class="container">
    <div class="player-page-header">
        <div class="league player-header-grid">
            <img class="player-face" src="images/player-pictures/{{player.id}}.png" alt="{{player.name}}">
            <div class="league-info player-header-main">
                <div class="league-title-row">
                    <h2>{{player.name}}</h2>
                    {{#if isLocal}}
                    <button type="button" id="refetch-player-btn" class="match-refetch-btn" data-player-id="{{player.id}}">
                        Refetch
                    </button>
                    {{/if}}
                </div>
                <div class="league-nation player-subinfo">
                    <div class="row player-club-row">
                        <img class="club-logo" src="images/logos/{{player.club}}.png" alt="{{player.clubName}}"
                            onclick="window.location.href='team?ID={{player.club}}'">
                        <span onclick="window.location.href='team?ID={{player.club}}'">{{player.clubName}}</span>
                    </div>
                    <div class="row player-position-row">
                        <span style="color: white;">{{player.displayPosition}}</span>
                    </div>
                    {{#if player.shirtNumbers}}
                    <div class="row player-position-row">
                        <span style="color: white;">Shirt Number: {{player.shirtNumbers}}</span>
                    </div>
                    {{/if}}
                </div>
            </div>
            <div class="player-meta">
                <div class="player-meta-row">
                    <span class="player-meta-label">Nationality:</span>
                    <span class="player-meta-value player-meta-value-with-flag">
                        {{#if player.nation}}
                        <img class="nation-flag" src="images/logos/{{player.nation}}.png" alt="{{player.nationName}}">
                        {{/if}}
                        <span>{{player.nationName}}</span>
                    </span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Birth Date:</span>
                    <span class="player-meta-value">{{formatDateOnly player.birthdate}}{{#if player.age}} ({{player.age}}){{/if}}</span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Birth Location:</span>
                    <span class="player-meta-value">{{player.birthLocation}}</span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Height:</span>
                    <span class="player-meta-value">{{player.height}} cm</span>
                </div>
            </div>
        </div>
    </div>

    <div class="rectangle">

        {{#if error}}
        <div class="error-message">{{error}}</div>
        {{else}}
        {{> rect-header title="Stats" leagues=leagues selectedLeagues=selectedPLeagues leaguepar="pleague" wikiInfo="These icons are explained on the" hideExpand=true headerClass="player-stats-header" showLeagueChip=true}}
        <table class="gf-table player-stats-table">
            <thead>
                <tr class="main-table-header">
                    <th>Stat</th>
                    <th class="center-td">Total</th>
                    <th class="center-td">Per game</th>
                    <th class="center-td" title="Last 5 games">Last 5</th>
                    <th class="center-td" title="Last 5 games, per game">Last 5 / game</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="apps"}} Appearances</td>
                    <td class="center-td">{{player.apps}}</td>
                    <td class="center-td player-stat-rate">-</td>
                    <td class="center-td">{{player.last5.apps}}</td>
                    <td class="center-td">-</td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="goals"}} Goals</td>
                    <td class="center-td">{{player.goals}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.goals player.apps}}</td>
                    <td class="center-td">{{player.last5.goals}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.goals player.last5.apps) (perGame player.goals player.apps)}}">{{perGame player.last5.goals player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="assists"}} Assists</td>
                    <td class="center-td">{{player.assists}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.assists player.apps}}</td>
                    <td class="center-td">{{player.last5.assists}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.assists player.last5.apps) (perGame player.assists player.apps)}}">{{perGame player.last5.assists player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="ga"}} Goals + Assists</td>
                    <td class="center-td">{{player.ga}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.ga player.apps}}</td>
                    <td class="center-td">{{player.last5.ga}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.ga player.last5.apps) (perGame player.ga player.apps)}}">{{perGame player.last5.ga player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">GA / 90</td>
                    <td class="center-td">{{player.gap90}}</td>
                    <td class="center-td player-stat-rate">-</td>
                    <td class="center-td">{{player.last5.gap90}}</td>
                    <td class="center-td">-</td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="rating"}} Rating</td>
                    <td class="center-td">{{player.avRating}}</td>
                    <td class="center-td player-stat-rate">-</td>
                    <td class="center-td">{{player.last5.avRating}}</td>
                    <td class="center-td">-</td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="minutes"}} Minutes</td>
                    <td class="center-td">{{player.minutes}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.minutes player.apps}}</td>
                    <td class="center-td">{{player.last5.minutes}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.minutes player.last5.apps) (perGame player.minutes player.apps)}}">{{perGame player.last5.minutes player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Starts</td>
                    <td class="center-td">{{player.starts}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.starts player.apps}}</td>
                    <td class="center-td">{{player.last5.starts}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.starts player.last5.apps) (perGame player.starts player.apps)}}">{{perGame player.last5.starts player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Substitute Apps</td>
                    <td class="center-td">{{player.substituteApps}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.substituteApps player.apps}}</td>
                    <td class="center-td">{{player.last5.substituteApps}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.substituteApps player.last5.apps) (perGame player.substituteApps player.apps) "lower"}}">{{perGame player.last5.substituteApps player.last5.apps}}</span></td>
                </tr>
                <tr>
