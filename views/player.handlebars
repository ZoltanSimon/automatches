                    <td class="center-td">{{player.last5.foulsAgainst}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.foulsAgainst player.last5.apps) (perGame player.foulsAgainst player.apps)}}">{{perGame player.last5.foulsAgainst player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Yellow Cards</td>
                    <td class="center-td">{{player.yellowCards}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.yellowCards player.apps}}</td>
                    <td class="center-td">{{player.last5.yellowCards}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.yellowCards player.last5.apps) (perGame player.yellowCards player.apps) "lower"}}">{{perGame player.last5.yellowCards player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Red Cards</td>
                    <td class="center-td">{{player.redCards}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.redCards player.apps}}</td>
                    <td class="center-td">{{player.last5.redCards}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.redCards player.last5.apps) (perGame player.redCards player.apps) "lower"}}">{{perGame player.last5.redCards player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Goals Conceded</td>
                    <td class="center-td">{{player.goalsConceded}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.goalsConceded player.apps}}</td>
                    <td class="center-td">{{player.last5.goalsConceded}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.goalsConceded player.last5.apps) (perGame player.goalsConceded player.apps) "lower"}}">{{perGame player.last5.goalsConceded player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Goalkeeper Saves</td>
                    <td class="center-td">{{player.goalkeeperSaves}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.goalkeeperSaves player.apps}}</td>
                    <td class="center-td">{{player.last5.goalkeeperSaves}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.goalkeeperSaves player.last5.apps) (perGame player.goalkeeperSaves player.apps)}}">{{perGame player.last5.goalkeeperSaves player.last5.apps}}</span></td>
                </tr>
            </tbody>
        </table>
        {{/if}}

    </div>
    <div class="rectangle">
        <div id="player-matches" class="table-container">
            {{> mini-match-list matches=matches}}
        </div>
    </div>
    {{> player-transfers playerTransfers=playerTransfers}}
    <div class="rectangle" style="padding: 8px;">
        <span>{{player.fullName}} is a football player, aged {{player.age}}{{#if player.nationName}}, representing the country of {{player.nationName}}{{/if}}. He was born on {{formatDateOnly player.birthdate}}, in {{player.birthLocation}}. {{player.name}} plays for <a
            href="team?ID={{player.club}}">{{player.clubName}}</a>, mainly as a {{player.displayPosition}}. He has made
            {{player.apps}} appearances and has scored {{player.goals}} goals, providing {{player.assists}} assists in
            all competitions this season, for club and country.<br /><br />
            If you are interested in his statistics in specific leagues, click on the league icons above to filter the
            match list below. You can also click on the matches to see more details about them, or on the teams to see
            their respective pages. </span>
    </div>
</div>