<script type="module" src="./../controllers/player.js"></script>
<link rel="stylesheet" href="css/league.css" />

<div class="container">
    <div class="player-page-header">
        <div class="league player-header-grid">
            <img class="player-face" src="images/player-pictures/{{player.id}}.png" alt="{{player.name}}">
            <div class="league-info player-header-main">
                <h2>{{player.name}}</h2>
                <div class="league-nation player-subinfo">
                    <div class="row player-club-row">
                        <img class="club-logo" src="images/logos/{{player.club}}.png" alt="{{player.clubName}}"
                            onclick="window.location.href='team?ID={{player.club}}'">
                        <span onclick="window.location.href='team?ID={{player.club}}'">{{player.clubName}}</span>
                    </div>
                    <div class="row player-position-row">
                        <span style="color: white;">{{player.position}}</span>
                    </div>
                    {{#if player.shirtNumbers}}
                    <div class="row player-position-row">
                        <span style="color: white;">Shirt Number: {{player.shirtNumbers}}</span>
                    </div>
                    {{/if}}
                </div>
            </div>
            <div class="player-meta">
                <div class="player-meta-row">
                    <span class="player-meta-label">Age:</span>
                    <span class="player-meta-value">{{player.age}}</span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Nationality:</span>
                    <span class="player-meta-value player-meta-value-with-flag">
                        <img class="nation-flag" src="images/logos/{{player.nation}}.png" alt="{{player.nationName}}">
                        <span>{{player.nationName}}</span>
                    </span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Birth Date:</span>
                    <span class="player-meta-value">{{formatDateOnly player.birthdate}}</span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Birth Location:</span>
                    <span class="player-meta-value">{{player.birthLocation}}</span>
                </div>
                <div class="player-meta-row">
                    <span class="player-meta-label">Height:</span>
                    <span class="player-meta-value">{{player.height}} cm</span>
                </div>
            </div>
        </div>
    </div>

    <div class="rectangle">

        {{#if error}}
        <div class="error-message">{{error}}</div>
        {{else}}
        <div class="rect-header" style="grid-template-columns: auto 1fr;">
            <div class="rect-title">
                <h2>Stats</h2>
            </div>
            <div class="rect-league-list"
                style="display: flex; position: static; opacity: 1; pointer-events: auto; margin-left: auto; grid-column: 2; grid-row: 1; justify-self: end; flex-wrap: nowrap; white-space: nowrap; gap: 8px; max-width: none; max-height: none; width: max-content; overflow: visible;">
                {{#each leagues}}
                <img width="30" src="/images/competitions/{{this.id}}.png" id="img-{{this.id}}" alt="{{this.name}}"
                    title="{{this.name}}"
                    class="pleague-league-to-select{{#if (includesID ../selectedPLeagues this.id)}} selected-league{{/if}}" />
                {{/each}}
            </div>
        </div>
        <div class="stats"
            style="grid-column: 1 / 4; width: 100%; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); --stat-icon-primary: #1D3557; --stat-icon-secondary: #F1FAEE; --stat-icon-danger: #E63946;">
            <div class="stat">
                <div class="label">{{> stat-icon name="apps"}} Appearances</div>
                <div class="value">{{player.apps}}</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="goals"}} Goals</div>
                <div class="value">{{player.goals}}</div>
                <div class="per-game">{{perGame player.goals player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="assists"}} Assists</div>
                <div class="value">{{player.assists}}</div>
                <div class="per-game">{{perGame player.assists player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="ga"}} Goals + Assists</div>
                <div class="value">{{player.ga}}</div>
                <div class="per-game">{{perGame player.ga player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">GA / 90</div>
                <div class="value">{{player.gap90}}</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="rating"}} Rating</div>
                <div class="value">{{player.avRating}}</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="minutes"}} Minutes</div>
                <div class="value">{{player.minutes}}</div>
                <div class="per-game">{{perGame player.minutes player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Starts</div>
                <div class="value">{{player.starts}}</div>
                <div class="per-game">{{perGame player.starts player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Substitute Apps</div>
                <div class="value">{{player.substituteApps}}</div>
                <div class="per-game">{{perGame player.substituteApps player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Captain Apps</div>
                <div class="value">{{player.captainApps}}</div>
                <div class="per-game">{{perGame player.captainApps player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="pens"}} Penalties</div>
                <div class="value">{{player.penalties}}</div>
                <div class="per-game">{{perGame player.penalties player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Penalties Won</div>
                <div class="value">{{player.penaltiesWon}}</div>
                <div class="per-game">{{perGame player.penaltiesWon player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Penalties Committed</div>
                <div class="value">{{player.penaltiesCommitted}}</div>
                <div class="per-game">{{perGame player.penaltiesCommitted player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="penaltiesMissed"}} Pens Missed</div>
                <div class="value">{{player.penaltiesMissed}}</div>
                <div class="per-game">{{perGame player.penaltiesMissed player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Penalties Saved</div>
                <div class="value">{{player.penaltiesSaved}}</div>
                <div class="per-game">{{perGame player.penaltiesSaved player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">{{> stat-icon name="shotsOn"}} Shots (On / Total)</div>
                <div class="value">{{player.shots}}</div>
                <div class="per-game">{{perGame player.shotsOn player.apps}} / {{perGame player.shotsTotal player.apps}}
                    per game</div>
            </div>
            <div class="stat">
                <div class="label">Offsides</div>
                <div class="value">{{player.offsides}}</div>
                <div class="per-game">{{perGame player.offsides player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Dribbles (Succ / Att)</div>
                <div class="value">{{player.dribbles}}</div>
                <div class="per-game">{{perGame player.dribblesSucc player.apps}} / {{perGame player.dribblesAttempts
                    player.apps}} per game</div>
            </div>
            <div class="stat">
                <div class="label">Duels (Won/Total)</div>
                <div class="value">{{player.duels}}</div>
                <div class="per-game">{{perGame player.duelsWon player.apps}} / {{perGame player.duelsTotal
                    player.apps}} per game</div>
            </div>
            <div class="stat">
                <div class="label">Key Passes</div>
                <div class="value">{{player.keyPasses}}</div>
                <div class="per-game">{{perGame player.keyPasses player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Passes</div>
                <div class="value">{{player.passes}}</div>
                <div class="per-game">{{perGame player.passes player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Accurate Passes</div>
                <div class="value">{{player.passesAccurate}}</div>
                <div class="per-game">{{perGame player.passesAccurate player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Pass Accuracy</div>
                <div class="value">{{player.passAccuracy}}</div>
            </div>
            <div class="stat">
                <div class="label">Tackles</div>
                <div class="value">{{player.tackles}}</div>
                <div class="per-game">{{perGame player.tackles player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Interceptions</div>
                <div class="value">{{player.interceptions}}</div>
                <div class="per-game">{{perGame player.interceptions player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Blocks</div>
                <div class="value">{{player.blocks}}</div>
                <div class="per-game">{{perGame player.blocks player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Fouls Committed</div>
                <div class="value">{{player.foulsCommited}}</div>
                <div class="per-game">{{perGame player.foulsCommited player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Fouls Against</div>
                <div class="value">{{player.foulsAgainst}}</div>
                <div class="per-game">{{perGame player.foulsAgainst player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Yellow Cards</div>
                <div class="value">{{player.yellowCards}}</div>
                <div class="per-game">{{perGame player.yellowCards player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Red Cards</div>
                <div class="value">{{player.redCards}}</div>
                <div class="per-game">{{perGame player.redCards player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Goals Conceded</div>
                <div class="value">{{player.goalsConceded}}</div>
                <div class="per-game">{{perGame player.goalsConceded player.apps}}/game</div>
            </div>
            <div class="stat">
                <div class="label">Goalkeeper Saves</div>
                <div class="value">{{player.goalkeeperSaves}}</div>
                <div class="per-game">{{perGame player.goalkeeperSaves player.apps}}/game</div>
            </div>
        </div>
        {{/if}}

    </div>
    <div class="rectangle" style="padding: 8px;">
        <span>{{player.fullName}} is a football player, aged {{player.age}}, representing the country of {{player.nationName}}. He was born on {{formatDateOnly player.birthdate}}, in {{player.birthLocation}}. {{player.name}} plays for <a
                href="team?ID={{player.club}}">{{player.clubName}}</a>, mainly as a {{player.position}}. He has made
            {{player.apps}} appearances and has scored {{player.goals}} goals, providing {{player.assists}} assists in
            all competitions this season, for club and country.<br /><br />
            If you are interested in his statistics in specific leagues, click on the league icons above to filter the
            match list below. You can also click on the matches to see more details about them, or on the teams to see
            their respective pages. </span>
    </div>
    <div class="rectangle">
        <div id="player-matches" class="table-container">
            {{> mini-match-list matches=matches}}
        </div>
    </div>
</div>