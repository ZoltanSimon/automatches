                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="pens"}} Penalties</td>
                    <td class="center-td">{{player.penalties}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.penalties player.apps}}</td>
                    <td class="center-td">{{player.last5.penalties}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.penalties player.last5.apps) (perGame player.penalties player.apps)}}">{{perGame player.last5.penalties player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Penalties Won</td>
                    <td class="center-td">{{player.penaltiesWon}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.penaltiesWon player.apps}}</td>
                    <td class="center-td">{{player.last5.penaltiesWon}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.penaltiesWon player.last5.apps) (perGame player.penaltiesWon player.apps)}}">{{perGame player.last5.penaltiesWon player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Penalties Committed</td>
                    <td class="center-td">{{player.penaltiesCommitted}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.penaltiesCommitted player.apps}}</td>
                    <td class="center-td">{{player.last5.penaltiesCommitted}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.penaltiesCommitted player.last5.apps) (perGame player.penaltiesCommitted player.apps) "lower"}}">{{perGame player.last5.penaltiesCommitted player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="penaltiesMissed"}} Pens Missed</td>
                    <td class="center-td">{{player.penaltiesMissed}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.penaltiesMissed player.apps}}</td>
                    <td class="center-td">{{player.last5.penaltiesMissed}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.penaltiesMissed player.last5.apps) (perGame player.penaltiesMissed player.apps) "lower"}}">{{perGame player.last5.penaltiesMissed player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Penalties Saved</td>
                    <td class="center-td">{{player.penaltiesSaved}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.penaltiesSaved player.apps}}</td>
                    <td class="center-td">{{player.last5.penaltiesSaved}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.penaltiesSaved player.last5.apps) (perGame player.penaltiesSaved player.apps)}}">{{perGame player.last5.penaltiesSaved player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">{{> stat-icon name="shotsOn"}} Shots (On / Total)</td>
                    <td class="center-td">{{player.shots}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.shotsOn player.apps}} / {{perGame player.shotsTotal player.apps}}</td>
                    <td class="center-td">{{player.last5.shots}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.shotsOn player.last5.apps) (perGame player.shotsOn player.apps)}}">{{perGame player.last5.shotsOn player.last5.apps}} / {{perGame player.last5.shotsTotal player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Offsides</td>
                    <td class="center-td">{{player.offsides}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.offsides player.apps}}</td>
                    <td class="center-td">{{player.last5.offsides}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.offsides player.last5.apps) (perGame player.offsides player.apps) "lower"}}">{{perGame player.last5.offsides player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Dribbles (Succ / Att)</td>
                    <td class="center-td">{{player.dribbles}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.dribblesSucc player.apps}} / {{perGame player.dribblesAttempts player.apps}}</td>
                    <td class="center-td">{{player.last5.dribbles}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.dribblesSucc player.last5.apps) (perGame player.dribblesSucc player.apps)}}">{{perGame player.last5.dribblesSucc player.last5.apps}} / {{perGame player.last5.dribblesAttempts player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Duels (Won / Total)</td>
                    <td class="center-td">{{player.duels}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.duelsWon player.apps}} / {{perGame player.duelsTotal player.apps}}</td>
                    <td class="center-td">{{player.last5.duels}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.duelsWon player.last5.apps) (perGame player.duelsWon player.apps)}}">{{perGame player.last5.duelsWon player.last5.apps}} / {{perGame player.last5.duelsTotal player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Key Passes</td>
                    <td class="center-td">{{player.keyPasses}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.keyPasses player.apps}}</td>
                    <td class="center-td">{{player.last5.keyPasses}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.keyPasses player.last5.apps) (perGame player.keyPasses player.apps)}}">{{perGame player.last5.keyPasses player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Passes</td>
                    <td class="center-td">{{player.passes}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.passes player.apps}}</td>
                    <td class="center-td">{{player.last5.passes}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.passes player.last5.apps) (perGame player.passes player.apps)}}">{{perGame player.last5.passes player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Accurate Passes</td>
                    <td class="center-td">{{player.passesAccurate}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.passesAccurate player.apps}}</td>
                    <td class="center-td">{{player.last5.passesAccurate}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.passesAccurate player.last5.apps) (perGame player.passesAccurate player.apps)}}">{{perGame player.last5.passesAccurate player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Pass Accuracy</td>
                    <td class="center-td">{{player.passAccuracy}}</td>
                    <td class="center-td player-stat-rate">-</td>
                    <td class="center-td">{{player.last5.passAccuracy}}</td>
                    <td class="center-td">-</td>
                </tr>
                <tr>
                    <td class="player-stat-name">Tackles</td>
                    <td class="center-td">{{player.tackles}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.tackles player.apps}}</td>
                    <td class="center-td">{{player.last5.tackles}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.tackles player.last5.apps) (perGame player.tackles player.apps)}}">{{perGame player.last5.tackles player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Interceptions</td>
                    <td class="center-td">{{player.interceptions}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.interceptions player.apps}}</td>
                    <td class="center-td">{{player.last5.interceptions}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.interceptions player.last5.apps) (perGame player.interceptions player.apps)}}">{{perGame player.last5.interceptions player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Blocks</td>
                    <td class="center-td">{{player.blocks}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.blocks player.apps}}</td>
                    <td class="center-td">{{player.last5.blocks}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.blocks player.last5.apps) (perGame player.blocks player.apps)}}">{{perGame player.last5.blocks player.last5.apps}}</span></td>
                </tr>
                <tr>
                    <td class="player-stat-name">Fouls Committed</td>
                    <td class="center-td">{{player.foulsCommited}}</td>
                    <td class="center-td player-stat-rate">{{perGame player.foulsCommited player.apps}}</td>
                    <td class="center-td">{{player.last5.foulsCommited}}</td>
                    <td class="center-td"><span class="player-stat-trend {{rateTrend (perGame player.last5.foulsCommited player.last5.apps) (perGame player.foulsCommited player.apps) "lower"}}">{{perGame player.last5.foulsCommited player.last5.apps}}</span></td>
