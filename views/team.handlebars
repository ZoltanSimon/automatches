<script src="/controllers/refetch-ui.js"></script>
<script type="module" src="/controllers/team.js"></script>

<div class="container">
    <div class="team-page-header team-page-header--team">
        <div class="team">
            <img src="/images/logos/{{thisTeam.ID}}.png" alt="{{thisTeam.name}} logo">
            <h1 class="heading-plain">{{thisTeam.name}}</h1>
            {{#if isLocal}}
            <button type="button" id="refetch-team-btn" class="match-refetch-btn" data-team-id="{{thisTeam.ID}}">
                Refetch
            </button>
            {{/if}}
        </div>
        <div class="team-details">
            {{#if teamNation}}
            <div class="team-meta">Nation: <img class="nation-flag" src="/images/logos/{{teamNation.ID}}.png" alt="">
                {{teamNation.name}}</div>
            {{/if}}
            {{#if teamStadium}}<div class="team-meta">Stadium: {{teamStadium}}</div>{{/if}}
            {{#if teamManager}}<div class="team-meta">Manager: {{teamManager}}</div>{{/if}}
        </div>
        <div class="team-info stat">
            <div class="team-competitions">
                {{#each teamStats.[0].leagues}}
                <div onclick="window.location.href='{{leagueUrl this.id}}'"
                    style="cursor: pointer; display: flex; align-items: center; gap: 5px;">
                    <img src="/images/competitions/{{this.id}}.png" class="logo-picture" />
                    <span>{{this.name}}</span>
                </div>
                {{/each}}
            </div>
        </div>
        {{> team-form teamStats.[0] stat=true}}
    </div>
    <div class="rectangle" id="team-statistics">
        {{> rect-header title="Statistics" hideExpand=true wikiInfo="How the average team rating is calculated:"
        wikiArticle="average-team-rating"}}
        <div class="table-container" style="grid-column: 1 / 4; width: 100%;">
            {{> team-summary teamStats.[0] eloMonthChange=eloMonthChange}}
            {{> team-stats-table teamStats.[0]}}
            {{> team-competition-table teamStats.[0]}}
        </div>
    </div>
        <div class="rectangle" id="team-transfers">
        {{> rect-header title="Latest Transfers" link="/transfers"}}
        <div class="table-container" style="grid-column: 1 / 4; width: 100%;">
            {{> player-transfer latestTransfers=teamTransfers}}
        </div>
        <p class="updated-at-label">Transfers updated at {{#if transferUpdatedAt}}{{formatDateOnly
            transferUpdatedAt}}{{else}}unknown{{/if}}</p>
    </div>
    <div class="rectangle" style="padding: 8px;">
        <span>{{thisTeam.name}} is a {{#if isNationalTeam}}national team{{else}}football club{{#if teamNation}} from
            {{teamNation.name}}{{/if}}{{/if}}{{#if teamManager}}, managed by {{teamManager}}{{/if}}{{#if teamStadium}},
            playing their home matches at {{teamStadium}}{{/if}}.
            This season they featured in the following competitions: {{#each teamStats.[0].leagues}}{{#unless
            @first}}{{#if @last}} and {{else}}, {{/if}}{{/unless}}{{this.name}}{{/each}},
            having {{plural teamStats.[0].wins "win"}}, {{plural teamStats.[0].draws "draw"}}, and {{plural
            teamStats.[0].losses "loss" "losses"}}. They've scored a total of {{plural teamStats.[0].total.goals
            "goal"}} from {{teamStats.[0].total.xG}} expected goals, conceding {{plural teamStats.[0].total.goalsAgainst
            "goal"}} from {{teamStats.[0].total.xGA}} expected goals.
            {{#if teamTopScorers.length}}Their current top {{#if (eq teamTopScorers.length 1)}}scorer is{{else}}scorers
            are{{/if}}
            {{#each teamTopScorers}}{{#unless @first}}{{#if @last}} and {{else}}, {{/if}}{{/unless}}<a
                href="{{playerUrl this.id this.name}}">{{this.name}}</a>{{/each}}
            with {{plural topGoals "goal"}}{{#unless (eq teamTopScorers.length 1)}} each{{/unless}}.{{/if}}
            {{#if eloMonthChange}}Their current <a href="/wiki/elo-ratings">Elo rating</a> is {{eloMonthChange.current}},
            {{#if (eq eloMonthChange.direction "flat")}}unchanged over the last 30 days{{else}}which has changed by
            {{eloMonthChange.display}} over the last 30 days{{/if}}.{{/if}}<br /><br />
            If you are interested in the featured competitions, click on the competition icons next to the team's logo
            and name. You can also click on the matches to see more details about them, or on the players to see their
            respective pages. </span>
    </div>
    <div class="rectangle">
        <span hidden id="league-name"></span>
        <span hidden id="league-id"></span>
        <span hidden id="round-no"></span> 
        <div id="fixtures-info" class="table-container">
            {{> match-list-table}}
        </div>
    </div>

    <div class="rectangle team-players-rect">
        <div class="team-players-header">
            <h2>Players</h2>
            {{#if showAllPlayerStats}}
            <span class="team-players-scope">Showing all competitions</span>
            <a class="more-link more-button" href="{{teamUrl thisTeam.ID thisTeam.name}}">Show latest tournament</a>
            {{else}}
            <span class="team-players-scope">Showing latest tournament: <strong>{{selectedPlayerStatsLeagueName}}</strong></span>
            <a class="more-link more-button" href="{{teamUrl thisTeam.ID thisTeam.name allStats=1}}">Show all stats</a>
            {{/if}}
        </div>
        <div id="player-list" class="table-container">
            {{> player-list-table big=false}}
        </div>
        <p class="updated-at-label">Squad updated at {{#if squadUpdatedAt}}{{formatDateOnly
            squadUpdatedAt}}{{else}}unknown{{/if}}</p>
    </div>

</div>