# Copy to .env and fill in. Used by docker-compose.local.yml.
DB_HOST=192.168.0.150
DB_PORT=3306
APP_PORT=3000

DB_NAME=football_db
DB_USER=football_user
DB_PASSWORD=
DB_ROOT_PASSWORD=root
DB_HOST_PORT=3307

# API-Football key (only needed for the admin/refetch features)
RAPID_API_HOST=v3.football.api-sports.io
RAPID_API_KEY=

# Host folder with JSON data (matches/, leagues/, players/)
DATA_DIR=./data
